# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=greyauction

# JWT Authentication (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=24h

# App
PORT=3001
NODE_ENV=development

# Frontend URL (used in emails, SMS links, payment callbacks)
FRONTEND_URL=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────────
# When unset, emails are logged to console (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@greyauction.com

# ─── SMS (Termii — https://termii.com) ──────────────────────────
# When unset, SMS are logged to console (dev mode)
TERMII_API_KEY=
TERMII_SENDER_ID=GreyAuct
TERMII_CHANNEL=generic        # generic | dnd | whatsapp

# ─── Payment Gateways ────────────────────────────────────────────
# When both unset, payments run in mock mode
# Flutterwave (https://flutterwave.com) — primary
FLUTTERWAVE_SECRET_KEY=
# Paystack (https://paystack.com) — fallback
PAYSTACK_SECRET_KEY=

# ─── AI / LLM Providers ──────────────────────────────────────────
# Admin can add providers via the UI (Admin → AI Providers).
# Presets include: OpenAI, Anthropic, DeepSeek, Qwen, GLM, Moonshot,
# OpenRouter, Novita, Groq, Mistral, Gemini, NVIDIA NIM, Minimax,
# StepFun, Ollama. Supply your own API keys in the admin UI.

# ─── Admin Seed (optional) ───────────────────────────────────────
# Used by `npm run seed:admins:dev`. When unset, defaults are used.
# ADMIN_SEED_EMAIL=admin@greyauction.com
# ADMIN_SEED_PASSWORD=Admin@12345

# ─── Optional: Cloud storage for document uploads ────────────────
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
