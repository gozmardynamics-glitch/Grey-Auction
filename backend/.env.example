# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=greyauction
# One-time schema bootstrap for the FIRST production deploy only:
# set DB_SYNCHRONIZE=true once to create all tables from entities, then remove
# and rely on migrations (see audit C1).
DB_SYNCHRONIZE=false

# JWT Authentication (generate with: openssl rand -base64 32)
# REQUIRED in production — the app refuses to boot without it (no dev-secret fallback).
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=24h

# App
PORT=3001
NODE_ENV=development

# Frontend URL (used in emails, SMS links, payment callbacks)
FRONTEND_URL=http://localhost:3000

# CORS origin (comma-separated for multiple). Defaults to FRONTEND_URL.
CORS_ORIGIN=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────────
# When unset, emails are logged to console (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@greyauction.com
# Brevo (https://www.brevo.com) — preferred mail service. Set BREVO_API_KEY to
# send via Brevo's Transactional Email API; or set the SMTP relay vars instead.
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM=noreply@greyauction.com

# ─── SMS (Termii — https://termii.com) ──────────────────────────
# When unset, SMS are logged to console (dev mode)
TERMII_API_KEY=
TERMII_SENDER_ID=GreyAuct
TERMII_CHANNEL=generic        # generic | dnd | whatsapp

# ─── SMS (Twilio — https://twilio.com) ──────────────────────────
# Secondary provider, used when Termii is not configured.
# TWILIO_ACCOUNT_SID: found on twilio.com/console (starts with AC)
# TWILIO_FROM_NUMBER: your purchased Twilio phone number (E.164, e.g. +12345678901)
# Auth: either TWILIO_AUTH_TOKEN, or an API Key pair (TWILIO_API_KEY_SID starts with SK)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# ─── Google OAuth (S1 — server-side ID-token verification) ─────
# Client ID from Google Cloud Console → APIs & Services → Credentials.
# When set, POST /auth/oauth/google verifies the ID token with google-auth-library;
# when unset, Google sign-in is rejected with 401.
GOOGLE_CLIENT_ID=

# ─── Clerk (removed — was unused) ──────────────────────────────

# ─── Exchange rates (L2 multi-currency) ────────────────────────
# Optional live feed URL. Must return JSON with either:
#   { "rates": { "USD": 1500, "GBP": 1900, ... } }
#   or { "data": { "USD": 1500, "GBP": 1900, ... } }
# A daily cron (03:00 UTC) fetches this URL and upserts rates automatically.
# When unset, seeded static NGN/USD/GHS/EUR defaults are used and the cron
# is a no-op. Example providers: exchangerate-api.com, open.er-api.com,
# or a self-hosted scraper. Include any API key in the URL if required.
# EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6/YOUR_API_KEY/latest/NGN
EXCHANGE_RATE_API_URL=

# ─── Payment Gateways ────────────────────────────────────────────
# The buyer picks a payment platform. When a provider's key is unset it is
# treated as not-configured and skipped (payments run in mock mode).
# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
# Flutterwave (https://flutterwave.com)
FLUTTERWAVE_SECRET_KEY=
# Flutterwave webhook signature (verif-hash) — set to the hash you register
FLUTTERWAVE_WEBHOOK_HASH=
# Interswitch (InterswitchCollect / Quickteller)
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
# OPay merchant
OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=
# Where gateways send webhooks (must be publicly reachable)
PAYMENT_WEBHOOK_URL=

# ─── AI / LLM Providers ──────────────────────────────────────────
# Admin can add providers via the UI (Admin → AI Providers).
# Presets include: OpenAI, Anthropic, DeepSeek, Qwen, GLM, Moonshot,
# OpenRouter, Novita, Groq, Mistral, Gemini, NVIDIA NIM, Minimax,
# StepFun, Ollama. Supply your own API keys in the admin UI.

# ─── Admin Seed (optional) ───────────────────────────────────────
# Used by `npm run seed:admins:dev`. When unset, defaults are used.
ADMIN_SEED_EMAIL=admin@greyauction.com
ADMIN_SEED_PASSWORD=Admin@12345

# ─── Object storage (images & documents) ─────────────────────
# Driver: 'local' (default, zero-config disk under ./uploads) or 's3'.
# 's3' targets any S3-compatible endpoint:
#   - MinIO (dev, self-hosted, zero egress):
#       STORAGE_DRIVER=s3
#       S3_ENDPOINT=http://localhost:9000
#       S3_ACCESS_KEY=greyauction
#       S3_SECRET_KEY=change-me-minio-password
#       S3_BUCKET=greyauction
#       S3_REGION=us-east-1
#   - Cloudflare R2 (prod, free egress — silent switch, no code change):
#       STORAGE_DRIVER=s3
#       S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#       S3_ACCESS_KEY=<R2 access key id>
#       S3_SECRET_KEY=<R2 secret access key>
#       S3_BUCKET=greyauction
#       S3_FORCE_PATH_STYLE=true
#       S3_PUBLIC_HOST=cdn.yourdomain.com   # optional public/CDN host
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=greyauction
S3_REGION=us-east-1
S3_PUBLIC_HOST=
# MinIO requires path-style; set false for AWS S3 virtual-host addressing.
S3_FORCE_PATH_STYLE=true