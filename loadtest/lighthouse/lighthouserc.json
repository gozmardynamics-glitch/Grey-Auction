{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "budgetPath": "../loadtest/lighthouse/budgets.json",
        "throttlingMethod": "provided",
        "chromeFlags": "--headless --no-sandbox"
      },
      "url": [
        "http://localhost:3000/en/about-us",
        "http://localhost:3000/en/faq"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 10 }],
        "server-response-time": ["warn", { "maxNumericValue": 800 }],
        "tbt": ["error", { "maxNumericValue": 300 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
