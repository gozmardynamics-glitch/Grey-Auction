# Copy to .env.local and fill in.

# ── API endpoints (5.6 BFF proxy) ────────────────────────────────────────────
# Browser traffic MUST go through the same-origin proxy so the backend bearer
# token never reaches client JavaScript: the proxy reads it from the HTTP-only
# session cookie. Do not point this at the backend directly.
NEXT_PUBLIC_API_URL=/api/proxy

# Server-side calls (server components, Auth.js callbacks, the proxy handler)
# use this absolute URL. Never expose it to the browser.
API_URL=http://localhost:3001/api

# WebSocket origin (sockets cannot use the same-origin proxy; auth is a
# short-lived ticket from POST /realtime/ticket).
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# ── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-in-production
